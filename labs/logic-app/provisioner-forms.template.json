{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "A365-Workshop-Provisioner"
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus2"
    },
    "upnDomain": {
      "type": "string",
      "metadata": { "description": "Verified domain in the target tenant, for example contoso.onmicrosoft.com." }
    },
    "tapLifetimeMinutes": {
      "type": "int",
      "defaultValue": 480
    },
    "aiReaderGroupId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "metadata": { "description": "Assigned role-assignable group with active standing AI Reader access. Not the dynamic licensing group." }
    },
    "formId": {
      "type": "string",
      "metadata": { "description": "Microsoft Form ID (the id= value from the form URL). Use Get-FormMetadata.ps1 to discover it." }
    },
    "fullNameQuestionId": {
      "type": "string",
      "metadata": { "description": "Question ID of the full-name text field." }
    },
    "emailQuestionId": {
      "type": "string",
      "metadata": { "description": "Question ID of the email text field." }
    },
    "formsConnectionName": {
      "type": "string",
      "defaultValue": "microsoftforms"
    },
    "office365ConnectionName": {
      "type": "string",
      "defaultValue": "office365-1"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned, UserAssigned",
        "userAssignedIdentities": {
          "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', concat(parameters('logicAppName'), '-AIReader-Membership'))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', concat(parameters('logicAppName'), '-AIReader-Membership'))]"
      ],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "upnDomain": {
              "type": "String",
              "defaultValue": "[parameters('upnDomain')]"
            },
            "tapLifetimeMinutes": {
              "type": "Int",
              "defaultValue": "[parameters('tapLifetimeMinutes')]"
            },
            "aiReaderGroupId": {
              "type": "String",
              "defaultValue": "[parameters('aiReaderGroupId')]"
            },
            "membershipIdentityResourceId": {
              "type": "String",
              "defaultValue": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', concat(parameters('logicAppName'), '-AIReader-Membership'))]"
            },
            "formId": {
              "type": "String",
              "defaultValue": "[parameters('formId')]"
            },
            "fullNameQuestionId": {
              "type": "String",
              "defaultValue": "[parameters('fullNameQuestionId')]"
            },
            "emailQuestionId": {
              "type": "String",
              "defaultValue": "[parameters('emailQuestionId')]"
            },
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            }
          },
          "triggers": {
            "When_a_new_response_is_submitted": {
              "type": "ApiConnectionWebhook",
              "splitOn": "@triggerBody()?['value']",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['microsoftforms']['connectionId']"
                  }
                },
                "body": {
                  "notificationUrl": "@{listCallbackUrl()}",
                  "eventType": "responseAdded"
                },
                "path": "/formapi/api/forms/@{encodeURIComponent(parameters('formId'))}/webhooks"
              }
            }
          },
          "actions": {
            "Get_response_details": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['microsoftforms']['connectionId']"
                  }
                },
                "method": "get",
                "path": "/formapi/api/forms('@{encodeURIComponent(parameters('formId'))}')/responses",
                "queries": {
                  "response_id": "@triggerOutputs()?['body/resourceData/responseId']"
                }
              }
            },
            "Create_user": {
              "type": "Http",
              "runAfter": {
                "Get_response_details": [ "Succeeded" ]
              },
              "inputs": {
                "method": "POST",
                "uri": "https://graph.microsoft.com/v1.0/users",
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "accountEnabled": true,
                  "displayName": "@body('Get_response_details')?[parameters('fullNameQuestionId')]",
                  "givenName": "@first(split(body('Get_response_details')?[parameters('fullNameQuestionId')], ' '))",
                  "surname": "@last(split(body('Get_response_details')?[parameters('fullNameQuestionId')], ' '))",
                  "mailNickname": "@toLower(replace(body('Get_response_details')?[parameters('fullNameQuestionId')], ' ', '.'))",
                  "userPrincipalName": "@concat(toLower(replace(body('Get_response_details')?[parameters('fullNameQuestionId')], ' ', '.')), '@', parameters('upnDomain'))",
                  "department": "workshop",
                  "usageLocation": "US",
                  "passwordProfile": {
                    "forceChangePasswordNextSignIn": false,
                    "password": "@concat('Aa1!', guid())"
                  }
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              }
            },
            "Add_AI_Reader_Group_Member": {
              "type": "Until",
              "runAfter": { "Issue_TAP": [ "Succeeded" ] },
              "expression": "@or(equals(outputs('Add_AI_Reader_Membership_Request')?['statusCode'], 204), not(and(equals(outputs('Add_AI_Reader_Membership_Request')?['statusCode'], 400), equals(body('Add_AI_Reader_Membership_Request')?['error']?['code'], 'Request_BadRequest'), contains(coalesce(body('Add_AI_Reader_Membership_Request')?['error']?['message'], ''), 'do not exist'))))",
              "limit": { "count": 12, "timeout": "PT3M" },
              "operationOptions": "FailWhenLimitsReached",
              "actions": {
                "Add_AI_Reader_Membership_Request": {
                  "type": "Http",
                  "runAfter": {},
                  "inputs": {
                    "method": "POST",
                    "uri": "@concat('https://graph.microsoft.com/v1.0/groups/', parameters('aiReaderGroupId'), '/members/$ref')",
                    "headers": { "Content-Type": "application/json" },
                    "body": {
                      "@@odata.id": "@concat('https://graph.microsoft.com/v1.0/directoryObjects/', body('Create_user')?['id'])"
                    },
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "identity": "@parameters('membershipIdentityResourceId')",
                      "audience": "https://graph.microsoft.com"
                    }
                  }
                },
                "Wait_for_Group_Replication": {
                    "type": "If",
                    "runAfter": { "Add_AI_Reader_Membership_Request": [ "Succeeded", "Failed", "TimedOut" ] },
                    "expression": "@and(equals(outputs('Add_AI_Reader_Membership_Request')?['statusCode'], 400), equals(body('Add_AI_Reader_Membership_Request')?['error']?['code'], 'Request_BadRequest'), contains(coalesce(body('Add_AI_Reader_Membership_Request')?['error']?['message'], ''), 'do not exist'))",
                    "actions": { "Replication_Delay": { "type": "Wait", "runAfter": {}, "inputs": { "interval": { "count": 10, "unit": "Second" } } } },
                    "else": { "actions": {} }
                }
              }
            },
            "Confirm_AI_Reader_Membership": {
                "type": "If",
                "runAfter": { "Add_AI_Reader_Group_Member": [ "Succeeded" ] },
                "expression": "@equals(outputs('Add_AI_Reader_Membership_Request')?['statusCode'], 204)",
                "actions": {},
                "else": {
                  "actions": {
                    "Fail_AI_Reader_Membership": {
                      "type": "Terminate",
                      "runAfter": {},
                      "inputs": { "runStatus": "Failed", "runError": { "code": "AIReaderMembershipFailed", "message": "@concat('AI Reader membership failed: ', string(outputs('Add_AI_Reader_Membership_Request')?['statusCode']), ' ', coalesce(body('Add_AI_Reader_Membership_Request')?['error']?['message'], 'No Graph error details.'))" } }
                    }
                  }
                }
            },
            "Issue_TAP": {
              "type": "Http",
              "runAfter": {
                "Create_user": [ "Succeeded" ]
              },
              "inputs": {
                "method": "POST",
                "uri": "@concat('https://graph.microsoft.com/v1.0/users/', body('Create_user')?['id'], '/authentication/temporaryAccessPassMethods')",
                "headers": { "Content-Type": "application/json" },
                "body": {
                  "lifetimeInMinutes": "@parameters('tapLifetimeMinutes')",
                  "isUsableOnce": false
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://graph.microsoft.com"
                }
              }
            },
            "Send_email": {
              "type": "ApiConnection",
              "runAfter": {
                "Confirm_AI_Reader_Membership": [ "Succeeded" ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365-1']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v2/Mail",
                "body": {
                  "To": "@body('Get_response_details')?[parameters('emailQuestionId')]",
                  "Subject": "Your A365 Workshop lab access",
                  "Body": "@concat('<p>Your A365 Workshop lab account is ready for Module 1.</p><p><b>Step 1 - Open the workshop:</b> Start with the <a href=\"https://cyberlorians.github.io/a365-hub/\">Module 1 student slides and labs</a>. Follow the numbered labs and return to the slides after each activity.</p><p><b>Step 2 - Sign in for Lab 2:</b> Open <a href=\"https://admin.microsoft.com/\">Microsoft 365 admin center</a> in a private (InPrivate or Incognito) browser window. Enter your lab username, select Temporary Access Pass if prompted, and enter the pass below. Follow the actual security prompts; if blocked, ask your instructor. Do not bypass policy.</p><ul><li><b>Username:</b> ', body('Create_user')?['userPrincipalName'], '</li><li><b>Temporary Access Pass:</b> ', body('Issue_TAP')?['temporaryAccessPass'], '</li><li><b>Pass lifetime:</b> ', string(body('Issue_TAP')?['lifetimeInMinutes']), ' minutes from issuance.</li></ul><p>Keep this email private. Do not share your pass or include it in screenshots. Use only your lab account, not a personal or production account.</p><p><b>Step 3 - Continue Module 1:</b> When Lab 3 directs you, open the <a href=\"https://admin.microsoft.com/\">Microsoft 365 admin center</a> using your lab account, then select <b>Agents &gt; All agents &gt; Registry</b>. Find <b>Project Beacon Mail Agent</b> and review it read-only. Do not block agents or change settings. If access is unavailable, tell your instructor and follow the presenter view.</p><p>You do not need to build an agent or run Advanced Hunting for Module 1. Return to the student slides to continue.</p>')",
                  "Importance": "Normal"
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "microsoftforms": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('formsConnectionName'))]",
                "connectionName": "[parameters('formsConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/microsoftforms')]"
              },
              "office365-1": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]",
                "connectionName": "[parameters('office365ConnectionName')]",
                "id": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/office365')]"
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[concat(parameters('logicAppName'), '-AIReader-Membership')]",
      "location": "[parameters('location')]"
    }
  ],
  "outputs": {
    "principalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
